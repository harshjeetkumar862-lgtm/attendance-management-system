# Server
PORT=5001
NODE_ENV=development

# Database
# Leave MONGODB_URI empty to use the built-in in-memory MongoDB (dev).
# For production set it to your real cluster, e.g.:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/attendance_db
MONGODB_URI=
DB_NAME=attendance_db

# Auth
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d

# OTP
OTP_PROVIDER=dev
OTP_TTL_MINUTES=5
# Local development uses an in-memory OTP; production login uses Firebase email links.
# Store the minified service-account JSON as a secret (never commit it).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated frontend origins allowed to call the API.
# Example: CORS_ORIGINS=https://your-frontend.onrender.com
CORS_ORIGINS=
